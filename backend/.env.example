# Copia este archivo como .env y completa los valores. Nunca subas el .env.
PORT=3001
NODE_ENV=development

# Base de datos MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=focus_power_fit
DB_USER=
DB_PASSWORD=
# true solo para crear las tablas en una base vacía
DB_SYNC=false

# Sesiones. Genera la clave con:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Dominios del frontend en producción, separados por coma
CORS_ORIGINS=

# Cantidad de proxies HTTPS delante del backend (Caddy, Nginx). En producción
# con Docker y dominio propio, normalmente 1. Vacío o 0 en desarrollo.
# Sin esto, los límites de intentos serían uno solo para todos los visitantes.
TRUST_PROXY=

# Correo (registro, recuperación de contraseña y recordatorios)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=

# Chatbot: URL de producción del flujo publicado en n8n (ver n8n/README.md)
FITBOT_WEBHOOK_URL=http://localhost:5679/webhook/e46ddba5-479d-4fb9-bf0d-806ab54a6344/chat

# Respaldos (ver la sección Respaldos del README)
# Carpeta fuera del proyecto, con ruta absoluta
RESPALDOS_DIR=
# Genera la clave con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Guárdala también fuera del servidor: sin ella no se puede recuperar ningún respaldo.
RESPALDO_CLAVE=
RESPALDO_DIAS=30
# Solo si mysqldump no se abre desde cualquier carpeta. Ejemplo en Windows:
# MYSQL_BIN_DIR=C:\Program Files\MySQL\MySQL Server 8.0\bin
MYSQL_BIN_DIR=
