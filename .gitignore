# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/frontend/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/frontend/coverage

# next.js
/frontend/.next/
/frontend/out/

# production
/frontend/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
 
# Backend
backend/node_modules/
backend/uploads/

# Datos reales de clientes
backend/data/

# Respaldos de base de datos
*.sql
# Respaldos locales de codigo
*.backup

# Archivo que Next.js crea solo al ejecutar "next dev"; no es parte del proyecto.
AGENTS.md

# Pruebas de QA: dependencias y resultados (pueden contener datos del entorno QA)
pruebas/node_modules/
pruebas/resultados/
