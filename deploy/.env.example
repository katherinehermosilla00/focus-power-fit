# Copia este archivo como deploy/.env en el servidor y completa los valores.
# deploy/.env nunca se sube a GitHub.
#
# Para generar claves:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"

# Dominio del sitio, sin https://. Debe apuntar a la IP del servidor.
DOMINIO=focuspowerfit.cl
# Dirección pública completa. Si cambia, hay que reconstruir el frontend.
URL_PUBLICA=https://focuspowerfit.cl

# Base de datos
DB_NAME=focus_power_fit
DB_USER=focus_app
DB_PASSWORD=
DB_ROOT_PASSWORD=
# true solo la primera vez con una base vacía (sin migrar datos), y luego false.
DB_SYNC=false

# Sesiones: clave de al menos 32 caracteres
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Correo (registro, recuperación de contraseña y recordatorios)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=

# Respaldos: carpeta del servidor fuera del proyecto, con ruta absoluta.
# Guarda la clave también fuera del servidor: sin ella no se recupera nada.
RESPALDOS_HOST_DIR=/srv/focus-power-fit/respaldos
RESPALDO_CLAVE=
RESPALDO_DIAS=30

# Solo para probar en un computador con otros servicios en esos puertos.
# PUERTO_HTTP=8080
# PUERTO_HTTPS=8443
# N8N_PUERTO=5680
