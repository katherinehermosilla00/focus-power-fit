# Caddy obtiene y renueva solo el certificado HTTPS del dominio
# (Let's Encrypt). Para "localhost" usa un certificado local de prueba.
{$DOMINIO} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	# La API y su estado van al backend; todo lo demás, al sitio.
	@api path /api/* /health
	handle @api {
		reverse_proxy backend:3001
	}

	handle {
		reverse_proxy frontend:3000
	}
}
